{
  "name": "card-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "26.13.1",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "typecheck": "panda codegen && tsc -p tsconfig.node.json && tsc -p tsconfig.client.json && tsc -p tsconfig.engine.json && tsc -p tsconfig.tooling.json",
    "lint": "eslint src e2e *.config.ts scripts eslint.config.js --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "fix": "pnpm lint --fix; pnpm format",
    "test": "vitest run",
    "test:guardrail": "bash .claude/hooks/test-block-dangerous-git.sh",
    "test:queue": "GIT_AUTHOR_NAME=queue-test GIT_AUTHOR_EMAIL=queue-test@example.invalid GIT_COMMITTER_NAME=queue-test GIT_COMMITTER_EMAIL=queue-test@example.invalid bash .agents/skills/tick/test/test-queue.sh",
    "test:read-main": "bash .agents/skills/read-main/test/test-read-main.sh",
    "check": "node scripts/check.mjs",
    "test:gates": "node scripts/test-gates.mjs",
    "test:boundaries": "node scripts/test-boundaries.mjs",
    "test:skill-links": "node scripts/test-skill-links-regression.mjs && node scripts/test-skill-links.mjs",
    "prepare": "husky && panda codegen",
    "start": "node src/server/main.ts",
    "build": "panda codegen && vite build",
    "dev": "panda codegen && concurrently --kill-others \"node --watch src/server/main.ts\" \"vite\"",
    "test:browser": "pnpm build && playwright test",
    "storybook": "panda codegen && storybook dev -p 6006 --no-open",
    "build-storybook": "panda codegen && storybook build",
    "test:working-markdown": "node scripts/test-working-markdown.mjs && node scripts/check-working-markdown.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "storybook": "^10.6.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@dnd-kit/react": "0.5.3",
    "@reduxjs/toolkit": "^2.14.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.71.0"
  }
}
